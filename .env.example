# Server-only; do not commit .env or service-account keys.
# Node does not auto-load .env; use --env-file=.env locally.
GOOGLE_CLIENT_ID=
# At least 32 characters of cryptographically random secret.
SESSION_SECRET=
# Exact origin without trailing slash; production must use HTTPS.
APP_ORIGIN=http://localhost:8765
GOOGLE_SHEET_ID=
# One-line service-account JSON; enclose JSON in single quotes in .env.
GOOGLE_SERVICE_ACCOUNT_JSON=
